# Auth
ADMIN_PASSWORD=trocar-essa-senha
JWT_SECRET=gerar-com-openssl-rand-base64-32
JWT_EXPIRES_IN=7d

# Postgres
POSTGRES_USER=linkanalytics
POSTGRES_PASSWORD=trocar-essa-senha
POSTGRES_DB=linkanalytics
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# URLs construídas (consumidas pela API — devem refletir os valores acima)
DATABASE_URL=postgresql://linkanalytics:trocar-essa-senha@localhost:5432/linkanalytics
REDIS_URL=redis://localhost:6379

# App
BASE_URL=http://localhost:3000
PORT=3000

# Confiança em proxies para extrair IP real do header X-Forwarded-For.
# - "loopback"      → confia apenas em 127.0.0.1 e ::1
# - "uniquelocal"   → confia em IPs privados (10.x, 172.16-31.x, 192.168.x) — Docker bridge, LAN
# - "<IP>/<CIDR>"   → confia em um IP/range específico (ex: do seu nginx/cloudflare)
# - "true"          → confia em qualquer proxy (NUNCA em produção pública — permite spoofing)
# Combina vários com vírgula. Default cobre dev local e Docker.
TRUST_PROXY=loopback, uniquelocal
